<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_overtime_indonesia_tree" model="ir.ui.view">
            <field name="name">hr.overtime.indonesia.list</field>
            <field name="model">hr.overtime.indonesia</field>
            <field name="arch" type="xml">
                <list string="Surat Perintah Kerja Lembur (SPKL)" decoration-success="state == 'approved'" decoration-muted="state == 'rejected'">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="overtime_type"/>
                    <field name="duration_hours"/>
                    <field name="overtime_multiplier_hours"/>
                    <field name="total_overtime_pay" widget="monetary"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_hr_overtime_indonesia_form" model="ir.ui.view">
            <field name="name">hr.overtime.indonesia.form</field>
            <field name="model">hr.overtime.indonesia</field>
            <field name="arch" type="xml">
                <form string="Formulir Lembur (SPKL Kemnaker)">
                    <header>
                        <button name="action_approve" string="Setujui Lembur" type="object" class="btn-success" invisible="state != 'draft'"/>
                        <button name="action_reject" string="Tolak Lembur" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <span class="o_form_label">Surat Perintah Kerja Lembur (SPKL)</span>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Identitas &amp; Waktu">
                                <field name="employee_id"/>
                                <field name="date"/>
                                <field name="overtime_type"/>
                                <field name="duration_hours"/>
                            </group>
                            <group string="Perhitungan Standar Kemnaker (1/173)">
                                <field name="hourly_rate"/>
                                <field name="overtime_multiplier_hours"/>
                                <field name="total_overtime_pay" class="font-weight-bold text-success"/>
                            </group>
                        </group>
                        <group string="Uraian Tugas / Instruksi Lembur">
                            <field name="reason" placeholder="Deskripsi pekerjaan yang diselesaikan saat lembur..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_overtime_indonesia" model="ir.actions.act_window">
            <field name="name">Persetujuan Lembur (SPKL)</field>
            <field name="res_model">hr.overtime.indonesia</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
