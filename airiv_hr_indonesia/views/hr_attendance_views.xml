<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_attendance_tree_inherit_geofence" model="ir.ui.view">
            <field name="name">hr.attendance.list.inherit.geofence</field>
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='check_out']" position="after">
                    <field name="workplace_zone_id"/>
                    <field name="check_in_distance"/>
                    <field name="geofence_status" widget="badge" decoration-success="geofence_status == 'valid'" decoration-danger="geofence_status == 'out_of_bounds'" decoration-info="geofence_status == 'manual'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
